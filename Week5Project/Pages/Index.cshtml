@page
@model Week5Project.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Class Info</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <!-- Form -->
            <div class="col-md-4">
                <h4>Add Class</h4>
                <form method="post" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")">
                    <div class="mb-3">
                        <label>Class Name</label>
                        <input class="form-control" asp-for="NewClass.ClassName" />
                        <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                    </div>
                    <div class="mb-3">
                        <label>Student Count</label>
                        <input class="form-control" asp-for="NewClass.StudentCount" type="number" />
                        <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        @(Model.IsEditing ? "Update Class" : "Save Changes")
                    </button>
                </form>
            </div>

            <!-- Table -->
            <div class="col-md-8">
                <h4>Class List</h4>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Week5Project.Pages.IndexModel.ClassList)

                        {
                           <tr>
                                <td>@item.Id</td>
                                <td>@item.ClassName</td>
                                <td>@item.StudentCount</td>
                                <td>@item.Description</td>
                                <td>
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                    </form>
                                
                                    <form method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm" asp-page-handler="SelectForEdit">Edit</button>
                                    </form>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
