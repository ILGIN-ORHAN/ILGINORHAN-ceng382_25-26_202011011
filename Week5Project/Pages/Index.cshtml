@page
@model Week5Project.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Class Info</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
        <div class="container mt-5">
        <div class="row">
            <!-- Left: Add / Update -->
            <div class="col-md-4">
                <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
               
                @if (Model.IsEditing)
                {
                    <form method="post" asp-page-handler="Update">
                        <input type="hidden" asp-for="NewClass.Id" />
                        <input type="hidden" asp-for="IsEditing" />

                        <div class="mb-3">
                            <label class="form-label">Class Name</label>
                            <input class="form-control" asp-for="NewClass.ClassName" />
                            <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Student Count</label>
                            <input class="form-control" asp-for="NewClass.StudentCount" type="number" />
                            <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                            <span class="text-danger" asp-validation-for="NewClass.Description"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Update Class</button>
                        <a href="/" class="btn btn-secondary ms-2">Cancel</a>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Add">
                        <input type="hidden" asp-for="NewClass.Id" />

                        <div class="mb-3">
                            <label class="form-label">Class Name</label>
                            <input class="form-control" asp-for="NewClass.ClassName" />
                            <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Student Count</label>
                            <input class="form-control" asp-for="NewClass.StudentCount" type="number" />
                            <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                            <span class="text-danger" asp-validation-for="NewClass.Description"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Add Class</button>
                    </form>
                }

            </div>

            <!-- Right: Filter + Table + Pagination -->
            <div class="col-md-8">
                <!-- Filter -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Filter Classes</h5>
                        <form method="get" class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Class Name</label>
                                <input class="form-control" asp-for="ClassNameFilter" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Min Students</label>
                                <input class="form-control" asp-for="MinStudentFilter" type="number" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Max Students</label>
                                <input class="form-control" asp-for="MaxStudentFilter" type="number" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end mb-3">
                                <button type="submit" class="btn btn-info w-100">Filter</button>
                                <a href="/" class="btn btn-outline-secondary ms-2">Reset</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Table -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h4 class="card-title">Class List</h4>
                        @if (Model.PaginatedClasses != null && Model.PaginatedClasses.Any())
                        {
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Student Count</th>
                                        <th>Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PaginatedClasses)
                                    {
                                        <tr>
                                            <td>@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td>@item.Description</td>
                                            <td>
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.HiddenId" />
                                                    <button type="submit" class="btn btn-danger btn-sm" asp-page-handler="Delete">Delete</button>
                                                </form>
                                                <form method="post" class="d-inline ms-2">
                                                    <input type="hidden" name="id" value="@item.HiddenId" />
                                                    <button type="submit" class="btn btn-warning btn-sm" asp-page-handler="SelectForEdit">Edit</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="alert alert-info">No classes found.</div>
                        }
                    </div>
                </div>

                <!-- Pagination -->
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&classNameFilter=@Model.ClassNameFilter&minStudentFilter=@Model.MinStudentFilter&maxStudentFilter=@Model.MaxStudentFilter">First</a>
                        </li>
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@(Model.CurrentPage - 1)&classNameFilter=@Model.ClassNameFilter&minStudentFilter=@Model.MinStudentFilter&maxStudentFilter=@Model.MaxStudentFilter">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?pageIndex=@i&classNameFilter=@Model.ClassNameFilter&minStudentFilter=@Model.MinStudentFilter&maxStudentFilter=@Model.MaxStudentFilter">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@(Model.CurrentPage + 1)&classNameFilter=@Model.ClassNameFilter&minStudentFilter=@Model.MinStudentFilter&maxStudentFilter=@Model.MaxStudentFilter">Next</a>
                        </li>
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&classNameFilter=@Model.ClassNameFilter&minStudentFilter=@Model.MinStudentFilter&maxStudentFilter=@Model.MaxStudentFilter">Last</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

</body>
</html>