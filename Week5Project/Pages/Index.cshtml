@page
@model Week5Project.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Class Info</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <!-- Form Column -->
            <div class="col-md-4">
                <h4>@(Model.IsEditing ? "Edit Class" : "Add Class")</h4>
                <form method="post" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")">
                    <input type="hidden" asp-for="NewClass.Id" />
                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input class="form-control" asp-for="NewClass.ClassName" />
                        <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input class="form-control" asp-for="NewClass.StudentCount" type="number" />
                        <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" asp-for="NewClass.Description"></textarea>
                        <span class="text-danger" asp-validation-for="NewClass.Description"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        @(Model.IsEditing ? "Update Class" : "Add Class")
                    </button>
                    @if (Model.IsEditing)
                    {
                        <a href="/" class="btn btn-secondary">Cancel</a>
                    }
                </form>
            </div>

            <!-- Table Column -->
            <div class="col-md-8">
                <h4>Class List</h4>
                @if (IndexModel.ClassList.Any())
                {
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Class Name</th>
                                <th>Student Count</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in IndexModel.ClassList)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.ClassName</td>
                                    <td>@item.StudentCount</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" 
                                                    asp-page-handler="Delete">Delete</button>
                                        </form>
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm" 
                                                    asp-page-handler="SelectForEdit">Edit</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No classes added yet.</div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>